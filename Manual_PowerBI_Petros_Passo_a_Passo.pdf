stream
// Crie uma medida por vez. NÃ£o cole o arquivo inteiro em Nova medida.

Publico oficial =
VAR Mes = MAX(Fotografias[Mes_Referencia])
VAR Foto = CALCULATE(MAX(Fotografias[Data_Fotografia]),
    KEEPFILTERS(Fotografias[Mes_Referencia] = Mes))
VAR Chaves = CALCULATETABLE(
    VALUES(Vinculos_Oficiais[ChaveParticipante]),
    KEEPFILTERS(Fotografias[Mes_Referencia] = Mes))
RETURN IF(ISBLANK(Foto), BLANK(),
    COALESCE(CALCULATE(COUNTROWS(Participantes),
        Participantes[Conciliacao_Avaliavel] = 1,
        KEEPFILTERS(Fotografias[Mes_Referencia] = Mes),
        KEEPFILTERS(TREATAS(Chaves,
            Participantes[ChaveParticipante]))), 0))

Sem email =
CALCULATE([Publico oficial], Participantes[Sem_Email] = 1)

Sem registro =
CALCULATE([Publico oficial], Participantes[Sem_Registro_Comunicacao] = 1)

Sem qualquer meio =
CALCULATE([Publico oficial], Participantes[Sem_Qualquer_Meio] = 1)

Com canal valido =
CALCULATE([Publico oficial], Participantes[Cobertura] = "Com canal vÃ¡lido")

Taxa sem email =
DIVIDE([Sem email], [Publico oficial])

Taxa canal valido =
DIVIDE([Com canal valido], [Publico oficial])

Contatos no recorte =
VAR Mes = MAX(Fotografias[Mes_Referencia])
VAR Chaves = CALCULATETABLE(
    VALUES(Vinculos_Oficiais[ChaveParticipante]),
    KEEPFILTERS(Fotografias[Mes_Referencia] = Mes))
RETURN IF(ISBLANK([Publico oficial]), BLANK(),
    COALESCE(CALCULATE(COUNTROWS(Contatos),
        Participantes[Conciliacao_Avaliavel] = 1,
        KEEPFILTERS(TREATAS(Chaves,
            Contatos[ChaveParticipante]))), 0))

Contatos com erro =
CALCULATE([Contatos no recorte], Contatos[Erros] > 0)

Contatos pendentes =
CALCULATE([Contatos no recorte], Contatos[Status_Tratamento] = "Pendente")

Contatos tratados =
CALCULATE([Contatos no recorte], Contatos[Status_Tratamento] = "Tratado")

Taxa erro contato =
DIVIDE([Contatos com erro], [Contatos no recorte])

Achados de contatos =
VAR Mes = MAX(Fotografias[Mes_Referencia])
VAR Pessoas = CALCULATETABLE(
    VALUES(Vinculos_Oficiais[ChaveParticipante]),
    KEEPFILTERS(Fotografias[Mes_Referencia] = Mes))
VAR ContatosSelecionados = CALCULATETABLE(
    VALUES(Contatos[ChaveContato]),
    Participantes[Conciliacao_Avaliavel] = 1,
    KEEPFILTERS(TREATAS(Pessoas, Contatos[ChaveParticipante])))
RETURN IF(ISBLANK([Publico oficial]), BLANK(),
    COALESCE(CALCULATE(COUNTROWS(Achados),
        Achados[Nivel] = "Contato",
        KEEPFILTERS(TREATAS(ContatosSelecionados,
            Achados[ChaveContato]))), 0))

Foto em foco =
VAR Mes = MAX(Fotografias[Mes_Referencia])
VAR Foto = CALCULATE(MAX(Fotografias[Data_Fotografia]),
    KEEPFILTERS(Fotografias[Mes_Referencia] = Mes))
RETURN IF(ISBLANK(Foto), "Sem arquivo neste mÃªs",
    "Fotografia: " & FORMAT(Foto, "dd/MM/yyyy"))

Taxa sem email anterior =
VAR Mes = MAX(Fotografias[Mes_Referencia])
VAR Anterior = EDATE(Mes, -1)
VAR PerfilAtual = CALCULATE(
    SELECTEDVALUE(Fotografias[Perfil_Regras]),
    KEEPFILTERS(Fotografias[Mes_Referencia] = Mes))
VAR PerfilAnterior = CALCULATE(
    SELECTEDVALUE(Fotografias[Perfil_Regras]),
    REMOVEFILTERS(Fotografias),
    Fotografias[Mes_Referencia] = Anterior)
RETURN IF(ISBLANK(PerfilAtual) || ISBLANK(PerfilAnterior) ||
    PerfilAtual <> PerfilAnterior, BLANK(),
    CALCULATE([Taxa sem email], REMOVEFILTERS(Fotografias),
        Fotografias[Mes_Referencia] = Anterior))

Variacao sem email pp =
VAR Atual = [Taxa sem email]
VAR Anterior = [Taxa sem email anterior]
RETURN IF(ISBLANK(Atual) || ISBLANK(Anterior), BLANK(),
    100 * (Atual - Anterior))

Situacao comparativo =
IF(ISBLANK([Taxa sem email anterior]) ||
    ISBLANK([Taxa sem email]),
    "Sem comparaÃ§Ã£o: confira mÃªs anterior, regras e pÃºblico",
    "ComparaÃ§Ã£o disponÃ­vel")

endstream
